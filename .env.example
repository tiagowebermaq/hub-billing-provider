HUB_ENV=dev
HUB_JWT_SECRET=troque-por-um-segredo-com-32-caracteres-ou-mais
HUB_JWT_EXPIRE_MINUTES=30
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HUB_ENCRYPTION_KEY=
HUB_ADMIN_EMAIL=admin@hub.local
HUB_ADMIN_PASSWORD=troque-no-primeiro-acesso
HUB_RABBITMQ_URL=amqp://hub:hub@localhost:5672/
HUB_REDIS_URL=redis://localhost:6379/0
HUB_DATABASE_URL=postgresql+psycopg://hub:hub@localhost:5432/hub
HUB_RENTAL_API_URL=http://localhost:9000/api/bills
# Segredo compartilhado para assinar (HMAC-SHA256) os lotes enviados; vazio = sem assinatura
HUB_RENTAL_API_SECRET=
HUB_LOG_LEVEL=INFO
# Chave pública de API do portal da Aegea/Corsan (Ocp-Apim-Subscription-Key, ver docs/descoberta-portais.md)
HUB_AEGEA_APIM_KEY=
# Caixa que recebe as faturas por e-mail (IMAP). Também dá para cadastrar no painel, aba E-mail (tem prioridade).
HUB_EMAIL_IMAP_HOST=
HUB_EMAIL_IMAP_PORT=993
HUB_EMAIL_USERNAME=41u6u31@heimber.com.br
HUB_EMAIL_PASSWORD=
HUB_EMAIL_FOLDER=INBOX
# Pasta para onde mover os e-mails lidos (vazio = só marca como lido)
HUB_EMAIL_PROCESSED_FOLDER=
HUB_EMAIL_POLL_SECONDS=300
# Senhas dos PDFs protegidos (ex.: 5 primeiros dígitos do CPF), separadas por vírgula
HUB_EMAIL_PDF_PASSWORDS=
